/* STATE VARIABLES */
let activeQuestions = [];
let userAnswers = {};
let lockedQuestions = {};
let bookmarkedQuestions = {};
let timeRemaining = 0;
let timerInterval = null;
let isExamSubmitted = false;
let currentFilter = 'all';

function setupAndStartExam() {
    const selectedTopic = document.getElementById('topic-select').value;
    const timeMinutes = parseInt(document.getElementById('time-input').value) || 90;

    if (selectedTopic === 'all') {
        activeQuestions = [...allQuestions];
    } else {
        activeQuestions = allQuestions.filter(q => q.topic === selectedTopic);
    }

    if (activeQuestions.length === 0) {
        alert("মনোনীত টপিকের জন্য কোনো প্রশ্ন পাওয়া যায়নি!");
        return;
    }

    timeRemaining = timeMinutes * 60;

    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('total-q-count').innerText = activeQuestions.length;
    document.getElementById('header-subtext').innerText = selectedTopic === 'all' 
        ? `পদার্থবিজ্ঞান ২য় পত্র • অধ্যায় ৩ • ${activeQuestions.length} MCQ`
        : `টপিক: ${selectedTopic} • ${activeQuestions.length} MCQ`;

    renderQuestions();
    renderPalette();
    startTimer();
}

function renderQuestions() {
    const container = document.getElementById('quiz-container');
    container.innerHTML = '';
    activeQuestions.forEach((q, index) => {
        const qCard = document.createElement('div');
        qCard.id = `q-card-${index}`;
        qCard.className = "q-card bg-darkcard border border-darkborder p-4 md:p-5 rounded-2xl shadow-md transition duration-200";
        qCard.setAttribute('data-status', 'skipped');

        let optionsHTML = '';
        q.options.forEach((opt, optIdx) => {
            optionsHTML += `
                <button id="opt-btn-${index}-${optIdx}" onclick="selectOption(${index}, ${optIdx})"
                    class="opt-btn-${index} w-full text-left flex items-center p-3 rounded-xl border border-slate-800 bg-slate-900/50 hover:bg-slate-800/80 cursor-pointer transition text-xs md:text-sm">
                    <span class="w-5 h-5 rounded-full border border-slate-600 flex items-center justify-center mr-3 shrink-0">
                        <span id="opt-dot-${index}-${optIdx}" class="w-2.5 h-2.5 rounded-full hidden"></span>
                    </span>
                    <span class="text-slate-200">${String.fromCharCode(65 + optIdx)}. ${opt}</span>
                </button>
            `;
        });

        qCard.innerHTML = `
            <div class="flex justify-between items-start mb-3">
                <span class="text-[10px] md:text-xs font-semibold px-2.5 py-1 rounded-md bg-cyan-950/80 text-cyan-400 border border-cyan-800/50">${q.topic}</span>
                <div class="flex items-center space-x-2">
                    <button onclick="toggleBookmark(${index})" id="bmk-btn-${index}" class="text-slate-500 hover:text-amber-400 text-sm">★</button>
                    <span class="text-xs text-slate-500 font-mono">#${index + 1}</span>
                </div>
            </div>
            <h3 class="text-sm md:text-base font-semibold text-slate-100 mb-3.5">${index + 1}. ${q.q}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">${optionsHTML}</div>
            <div id="explanation-${index}" class="mt-4 p-3 rounded-xl bg-slate-900/90 text-xs text-slate-300 hidden border border-slate-800 space-y-1"></div>
        `;
        container.appendChild(qCard);
    });
}

function renderPalette() {
    const palette = document.getElementById('palette-grid');
    palette.innerHTML = '';
    activeQuestions.forEach((_, index) => {
        const btn = document.createElement('button');
        btn.id = `palette-btn-${index}`;
        btn.onclick = () => scrollToQuestion(index);
        btn.className = "w-7 h-7 rounded-md text-[10px] font-medium bg-slate-900 border border-slate-800 text-slate-400 hover:bg-slate-800 transition flex items-center justify-center";
        btn.innerText = index + 1;
        palette.appendChild(btn);
    });
}

function selectOption(qIndex, optIndex) {
    if (lockedQuestions[qIndex] || isExamSubmitted) return;
    userAnswers[qIndex] = optIndex;
    lockedQuestions[qIndex] = true;

    const allOptBtns = document.querySelectorAll(`.opt-btn-${qIndex}`);
    allOptBtns.forEach((btn, idx) => {
        btn.disabled = true;
        btn.classList.remove('hover:bg-slate-800/80', 'cursor-pointer');
        btn.classList.add('cursor-not-allowed', 'option-disabled');
        if (idx === optIndex) {
            btn.classList.remove('border-slate-800', 'bg-slate-900/50');
            btn.classList.add('border-cyan-500', 'bg-cyan-950/40');
            const dot = document.getElementById(`opt-dot-${qIndex}-${idx}`);
            if (dot) {
                dot.classList.remove('hidden');
                dot.classList.add('bg-cyan-400');
            }
        } else {
            btn.classList.add('opacity-40');
        }
    });

    const paletteBtn = document.getElementById(`palette-btn-${qIndex}`);
    if (paletteBtn && !bookmarkedQuestions[qIndex]) {
        paletteBtn.className = "w-7 h-7 rounded-md text-[10px] font-medium bg-cyan-600 border border-cyan-500 text-white transition flex items-center justify-center shadow-md";
    }
    document.getElementById('answered-count').innerText = Object.keys(userAnswers).length;
}

function toggleBookmark(index) {
    bookmarkedQuestions[index] = !bookmarkedQuestions[index];
    const btn = document.getElementById(`bmk-btn-${index}`);
    const paletteBtn = document.getElementById(`palette-btn-${index}`);

    if (bookmarkedQuestions[index]) {
        btn.classList.remove('text-slate-500');
        btn.classList.add('text-amber-400');
        if (paletteBtn) {
            paletteBtn.className = "w-7 h-7 rounded-md text-[10px] font-medium bg-amber-500 border border-amber-400 text-slate-950 font-bold transition flex items-center justify-center shadow-md";
        }
    } else {
        btn.classList.remove('text-amber-400');
        btn.classList.add('text-slate-500');
        if (paletteBtn) {
            if (userAnswers[index] !== undefined) {
                paletteBtn.className = "w-7 h-7 rounded-md text-[10px] font-medium bg-cyan-600 border border-cyan-500 text-white transition flex items-center justify-center shadow-md";
            } else {
                paletteBtn.className = "w-7 h-7 rounded-md text-[10px] font-medium bg-slate-900 border border-slate-800 text-slate-400 transition flex items-center justify-center";
            }
        }
    }
}

function scrollToQuestion(index) {
    const el = document.getElementById(`q-card-${index}`);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function startTimer() {
    const timerDisplay = document.getElementById('timer-display');
    timerInterval = setInterval(() => {
        timeRemaining--;
        let minutes = Math.floor(timeRemaining / 60);
        let seconds = timeRemaining % 60;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        seconds = seconds < 10 ? '0' + seconds : seconds;
        timerDisplay.innerText = `${minutes}:${seconds}`;

        if (timeRemaining <= 300) {
            timerDisplay.classList.remove('text-amber-400');
            timerDisplay.classList.add('text-rose-500');
        }
        if (timeRemaining <= 0) {
            clearInterval(timerInterval);
            confirmAndSubmit();
        }
    }, 1000);
}

function openSubmitConfirmModal() {
    document.getElementById('confirm-answered').innerText = Object.keys(userAnswers).length;
    document.getElementById('confirm-modal').classList.remove('hidden');
}

function closeSubmitConfirmModal() {
    document.getElementById('confirm-modal').classList.add('hidden');
}

function confirmAndSubmit() {
    closeSubmitConfirmModal();
    if (isExamSubmitted) return;
    isExamSubmitted = true;
    clearInterval(timerInterval);

    let correctCount = 0;
    let wrongCount = 0;
    let skippedCount = 0;
    let topicStats = {};

    activeQuestions.forEach((q, index) => {
        const selected = userAnswers[index];
        const isCorrect = selected === q.correct;
        const qCard = document.getElementById(`q-card-${index}`);

        if (!topicStats[q.topic]) {
            topicStats[q.topic] = { total: 0, correct: 0, wrong: 0, skipped: 0 };
        }
        topicStats[q.topic].total++;

        const expBox = document.getElementById(`explanation-${index}`);
        expBox.classList.remove('hidden');

        if (selected !== undefined) {
            if (isCorrect) {
                correctCount++;
                topicStats[q.topic].correct++;
                qCard.setAttribute('data-status', 'correct');
                qCard.className = "q-card bg-darkcard border-2 border-emerald-500/80 p-4 md:p-5 rounded-2xl shadow-md";
                expBox.innerHTML = `
                    <p class="text-emerald-400 font-bold">✓ সঠিক উত্তর!</p>
                    <p><b>আপনার উত্তর:</b> ${String.fromCharCode(65 + selected)}. ${q.options[selected]}</p>
                    <p><b>সঠিক উত্তর:</b> <span class="text-emerald-400 font-bold">${String.fromCharCode(65 + q.correct)}. ${q.options[q.correct]}</span></p>
                    <p class="text-slate-400 mt-1"><b>ব্যাখ্যা:</b> ${q.exp}</p>
                `;
            } else {
                wrongCount++;
                topicStats[q.topic].wrong++;
                qCard.setAttribute('data-status', 'wrong');
                qCard.className = "q-card bg-darkcard border-2 border-rose-500/80 p-4 md:p-5 rounded-2xl shadow-md";
                expBox.innerHTML = `
                    <p class="text-rose-400 font-bold">✕ ভুল উত্তর!</p>
                    <p><b>আপনার উত্তর:</b> <span class="text-rose-300">${String.fromCharCode(65 + selected)}. ${q.options[selected]}</span></p>
                    <p><b>সঠিক উত্তর:</b> <span class="text-emerald-400 font-bold">${String.fromCharCode(65 + q.correct)}. ${q.options[q.correct]}</span></p>
                    <p class="text-slate-400 mt-1"><b>ব্যাখ্যা:</b> ${q.exp}</p>
                `;
            }
        } else {
            skippedCount++;
            topicStats[q.topic].skipped++;
            qCard.setAttribute('data-status', 'skipped');
            qCard.className = "q-card bg-darkcard border-2 border-amber-500/50 p-4 md:p-5 rounded-2xl shadow-md";
            expBox.innerHTML = `
                <p class="text-amber-400 font-bold">! উত্তর দেওয়া হয়নি (Skipped)</p>
                <p><b>সঠিক উত্তর:</b> <span class="text-emerald-400 font-bold">${String.fromCharCode(65 + q.correct)}. ${q.options[q.correct]}</span></p>
                <p class="text-slate-400 mt-1"><b>ব্যাখ্যা:</b> ${q.exp}</p>
            `;
        }
    });

    const totalQuestions = activeQuestions.length;
    const negativeDeduction = wrongCount * 0.25;
    const finalScore = Math.max(0, correctCount - negativeDeduction);
    const percentage = totalQuestions > 0 ? (finalScore / totalQuestions) * 100 : 0;

    document.getElementById('res-score').innerText = `${finalScore.toFixed(2)} / ${totalQuestions}`;
    document.getElementById('res-correct').innerText = correctCount;
    document.getElementById('res-wrong').innerText = wrongCount;
    document.getElementById('res-skipped').innerText = skippedCount;
    document.getElementById('res-percentage').innerText = `${percentage.toFixed(1)}%`;

    const topicListContainer = document.getElementById('topic-analysis-list');
    topicListContainer.innerHTML = '';

    for (const [topic, stat] of Object.entries(topicStats)) {
        const percent = stat.total > 0 ? Math.round((stat.correct / stat.total) * 100) : 0;
        let barColor = "bg-rose-500";
        if (percent >= 75) barColor = "bg-emerald-500";
        else if (percent >= 50) barColor = "bg-amber-500";

        const topicRow = document.createElement('div');
        topicRow.className = "bg-slate-900/60 p-3 rounded-xl border border-slate-800 space-y-1";
        topicRow.innerHTML = `
            <div class="flex justify-between text-xs font-semibold">
                <span class="text-slate-200">${topic}</span>
                <span class="text-slate-400">${stat.correct}/${stat.total} (${percent}%)</span>
            </div>
            <div class="w-full bg-slate-950 rounded-full h-1.5 overflow-hidden">
                <div class="${barColor} h-1.5 rounded-full" style="width: ${percent}%"></div>
            </div>
        `;
        topicListContainer.appendChild(topicRow);
    }

    document.getElementById('filter-bar').classList.remove('hidden');
    document.getElementById('filter-bar').classList.add('flex');
    document.getElementById('result-modal').classList.remove('hidden');
}

function closeResultModal() {
    document.getElementById('result-modal').classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function filterFromModal(status) {
    closeResultModal();
    applyFilter(status);
}

function applyFilter(status) {
    currentFilter = status;
    const cards = document.querySelectorAll('.q-card');

    ['all', 'correct', 'wrong', 'skipped'].forEach(st => {
        const btn = document.getElementById(`btn-filter-${st}`);
        if (btn) {
            if (st === status) {
                btn.className = "px-3 py-1.5 text-xs font-bold rounded-xl bg-accent text-white transition";
            } else {
                btn.className = "px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 text-slate-400 border border-slate-700 transition";
            }
        }
    });

    cards.forEach(card => {
        if (status === 'all') {
            card.classList.remove('hidden');
        } else {
            if (card.getAttribute('data-status') === status) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        }
    });
}
</script>
