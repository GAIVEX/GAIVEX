    </div>
</div>

<!-- RESULT MODAL -->
<div id="result-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-darkcard border border-darkborder w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden">
        <div class="p-5 bg-slate-900/60 border-b border-darkborder flex justify-between items-center">
            <div>
                <h2 class="text-xl font-bold text-white">ফলাফল এনালাইসিস</h2>
                <p class="text-xs text-slate-400">Physics 2nd Paper • Chapter 3</p>
            </div>
            <button onclick="closeResultModal()" class="text-slate-400 hover:text-white text-xl font-bold p-2">✕</button>
        </div>
        <div class="p-6 overflow-y-auto custom-scrollbar space-y-6">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                <div class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800 text-center">
                    <span class="text-[11px] text-slate-400 block mb-1">প্রাপ্ত নম্বর</span>
                    <span id="res-score" class="text-lg font-extrabold text-accent">0</span>
                </div>
                <div onclick="filterFromModal('correct')" class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800 text-center cursor-pointer hover:border-emerald-500/50 transition">
                    <span class="text-[11px] text-slate-400 block mb-1">সঠিক উত্তর</span>
                    <span id="res-correct" class="text-lg font-extrabold text-emerald-400">0</span>
                </div>
                <div onclick="filterFromModal('wrong')" class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800 text-center cursor-pointer hover:border-rose-500/50 transition">
                    <span class="text-[11px] text-slate-400 block mb-1">ভুল উত্তর</span>
                    <span id="res-wrong" class="text-lg font-extrabold text-rose-400">0</span>
                </div>
                <div onclick="filterFromModal('skipped')" class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800 text-center cursor-pointer hover:border-amber-500/50 transition">
                    <span class="text-[11px] text-slate-400 block mb-1">স্কিপ করা</span>
                    <span id="res-skipped" class="text-lg font-extrabold text-amber-400">0</span>
