                <button onclick="applyFilter('correct')" id="btn-filter-correct" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 text-emerald-400 border border-slate-700 transition">সঠিক উত্তর</button>
                <button onclick="applyFilter('wrong')" id="btn-filter-wrong" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 text-rose-400 border border-slate-700 transition">ভুল উত্তর</button>
                <button onclick="applyFilter('skipped')" id="btn-filter-skipped" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 text-amber-400 border border-slate-700 transition">স্কিপড</button>
