        <button onclick="setupAndStartExam()" class="w-full py-3.5 bg-accent hover:bg-accenthover text-white text-base md:text-lg font-bold rounded-2xl transition shadow-lg shadow-cyan-900/40">পরীক্ষা শুরু করুন</button>
