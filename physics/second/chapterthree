            </div>
            <div class="flex justify-between items-center pt-4 border-t border-slate-800">
                <button onclick="location.reload()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold transition">নতুন পরীক্ষা দিন</button>
                <button onclick="closeResultModal()" class="px-5 py-2.5 bg-accent hover:bg-accenthover text-white rounded-xl text-xs font-bold transition">উত্তরমালা ও ব্যাখ্যা দেখুন</button>
            </div>
        </div>
    </div>
</div>

<script>
/* 150 MCQs QUESTION BANK FOR CURRENT ELECTRICITY */
const allQuestions = [
{id:1,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"তড়িৎ প্রবাহের (Electric Current) SI একক কোনটি?",options:["Volt","Ampere","Ohm","Coulomb"],correct:1,exp:"প্রতি সেকেন্ডে অতিক্রান্ত চার্জের পরিমাণই তড়িৎ প্রবাহ, একক অ্যাম্পিয়ার (A)।"},
{id:2,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"তড়িৎ প্রবাহঘনত্ব (Current Density, J) এর একক কোনটি?",options:["A/m²","A/m","A m²","C/m²"],correct:0,exp:"J = I/A; তাই এর SI একক A/m²।"},
{id:3,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"তড়িৎ প্রবাহঘনত্ব (J) কোন ধরনের রাশি?",options:["স্কেলার রাশি","ভেক্টর রাশি","মাত্রাহীন রাশি","কোনোটিই নয়"],correct:1,exp:"তড়িৎ প্রবাহ স্কেলার হলেও প্রবাহঘনত্ব একটি ভেক্টর রাশি।"},
{id:4,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"ইলেকট্রনের তারণ বেগ (Drift Velocity, v_d) ও প্রবাহের (I) সম্পর্ক কোনটি?",options:["I = n A e v_d","I = n e v_d","I = n A v_d","I = v_d / (nAe)"],correct:0,exp:"I = n A e v_d, যেখানে n হলো প্রতি একক আয়তনে মুক্ত ইলেকট্রন সংখ্যা।"},
{id:5,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"কোনো পরিবাহীর মধ্য দিয়ে 2 sec-এ 10 C চার্জ প্রবাহিত হলে প্রবাহ কত?",options:["20 A","5 A","0.2 A","12 A"],correct:1,exp:"I = Q/t = 10 C / 2 s = 5 A।"},
{id:6,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"তড়িৎ চালক শক্তির (EMF) SI একক কোনটি?",options:["Joule","Volt (J/C)","Watt","Ampere"],correct:1,exp:"একক আধানকে সম্পূর্ণ বর্তনী ঘুরিয়ে আনতে কৃত কাজই EMF, যার একক Volt (J/C)।"},
{id:7,topic:"তড়িৎ প্রবাহ ও তার চালক শক্তি",q:"ধাতব পরিবাহীতে তড়িৎ পরিবহনের জন্য মূলত দায়ী কোনটি?",options:["প্রোটন","পজিট্রন","মুক্ত ইলেকট্রন","আয়ন"],correct:2,exp:"ধাতুর স্ফটিক জালি বা কেলাসে থাকা মুক্ত ইলেকট্রনসমূহ তড়িৎ পরিবহন করে।"},
