        <div class="bg-darkcard p-4 rounded-2xl border border-darkborder flex justify-between items-center shadow-lg">
            <span class="text-xs md:text-sm text-slate-400">উত্তর দেওয়া হয়েছে: <span id="answered-count" class="font-bold text-accent">0</span> / <span id="total-q-count">0</span></span>
            <button onclick="openSubmitConfirmModal()" class="px-5 py-2.5 bg-accent hover:bg-accenthover text-white text-xs md:text-sm font-semibold rounded-xl transition shadow-md">পরীক্ষা সাবমিট করুন</button>
        </div>
    </section>

    <!-- RIGHT PALETTE -->
    <aside class="lg:col-span-1">
        <div class="sticky top-20 bg-darkcard p-4 md:p-5 rounded-2xl border border-darkborder shadow-xl space-y-4">
            <h3 class="font-bold text-sm md:text-base text-slate-200 border-b border-slate-800 pb-2">প্রশ্ন নেভিগেশন</h3>
            <div class="grid grid-cols-3 gap-2 text-[10px] md:text-xs text-slate-400">
                <span class="flex items-center"><span class="w-2.5 h-2.5 bg-slate-800 border border-slate-700 rounded-full mr-1"></span>বাকি</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 bg-cyan-600 rounded-full mr-1"></span>উত্তরিত</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 bg-amber-500 rounded-full mr-1"></span>বুকমার্ক</span>
            </div>
            <div id="palette-grid" class="grid grid-cols-5 gap-1.5 max-h-[50vh] lg:max-h-[60vh] overflow-y-auto custom-scrollbar pr-1"></div>
            <button onclick="openSubmitConfirmModal()" class="w-full py-2.5 bg-rose-600/80 hover:bg-rose-600 text-white text-xs md:text-sm font-semibold rounded-xl transition">পরীক্ষা শেষ করুন</button>
        </div>
    </aside>
</main>

<!-- CONFIRM MODAL -->
<div id="confirm-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-darkcard border border-darkborder max-w-md w-full p-6 rounded-3xl text-center space-y-4 shadow-2xl">
        <div class="w-12 h-12 bg-cyan-500/10 text-cyan-400 rounded-full flex items-center justify-center mx-auto border border-cyan-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
