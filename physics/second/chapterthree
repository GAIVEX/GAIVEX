</div>

<!-- HEADER -->
<header class="sticky top-0 z-40 bg-darkcard/90 backdrop-blur-md border-b border-darkborder shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
        <div>
            <h1 class="text-base md:text-xl font-bold text-accent">চল তড়িৎ</h1>
            <p id="header-subtext" class="text-[10px] md:text-xs text-slate-400">পদার্থবিজ্ঞান ২য় পত্র • অধ্যায় ৩</p>
        </div>
        <div class="flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 md:px-4 md:py-2 rounded-xl border border-slate-800">
